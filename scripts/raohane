#!/usr/bin/env bash
set -euo pipefail

QS_CONFIG="${RAOHANE_QS_CONFIG:-raohane}"
SERVICE="${RAOHANE_SERVICE:-raohane.service}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
RUNTIME="${RAOHANE_RUNTIME:-$CONFIG_HOME/quickshell/$QS_CONFIG}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Raohane CLI

Usage: raohane <command> [args]

Shell:
  run | start | stop | restart | status | logs
  launcher | control | settings | media | desktop | session | translate
  wallpaper [toggle|random]
  theme [list|import FILE|import-serpantinum PATH|remove ID|export ID FILE]

Diagnostics:
  doctor [all|graphics|deps|services|runtime|phase4]
  validate phase4 [--exercise] [--lock] [--capture] [--translate]
  validate release [--phase4|--full] [--report PATH]
  wifi [status|menu]
  audio [status|recover [percent]]
EOF
}

ipc() {
  qs -c "$QS_CONFIG" ipc call "$@"
}

prune_runtime_if_needed() {
  local pruner="$RUNTIME/scripts/prune-runtime.sh"
  local retired=0

  for path in \
    "$RUNTIME/modules/common" \
    "$RUNTIME/modules/ii" \
    "$RUNTIME/services" \
    "$RUNTIME/GlobalStates.qml" \
    "$RUNTIME/panelFamilies/IllogicalImpulseFamily.qml"; do
    if [[ -e "$path" ]]; then
      retired=1
      break
    fi
  done

  ((retired)) || return 0

  if [[ ! -f "$pruner" ]]; then
    echo "[Raohane] Installed runtime still contains retired QML trees, but $pruner is missing." >&2
    echo '[Raohane] Run ./install-raohane.sh from an up-to-date checkout.' >&2
    return 1
  fi

  echo '[Raohane] Removing retired compatibility trees from installed runtime...'
  bash "$pruner" "$RUNTIME"
}

service_failure_report() {
  echo >&2
  echo "[Raohane] $SERVICE did not stay running." >&2
  echo '[Raohane] Service status:' >&2
  systemctl --user --no-pager --full status "$SERVICE" >&2 || true
  echo >&2
  echo '[Raohane] Recent runtime log:' >&2
  journalctl --user -u "$SERVICE" -n 35 --no-pager >&2 || true
  echo >&2
  echo '[Raohane] For the clearest QML/runtime error run:' >&2
  echo '  raohane stop' >&2
  echo '  raohane run' >&2
}

service_start() {
  systemctl --user reset-failed "$SERVICE" >/dev/null 2>&1 || true
  if ! systemctl --user start "$SERVICE"; then
    service_failure_report
    return 1
  fi

  sleep 1
  if ! systemctl --user --quiet is-active "$SERVICE"; then
    service_failure_report
    return 1
  fi

  echo "[Raohane] $SERVICE is active."
}

service_restart() {
  systemctl --user stop "$SERVICE" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$SERVICE" >/dev/null 2>&1 || true
  service_start
}

foreground_shell_pid() {
  local pid=""
  local i=0
  local -a argv=()

  while IFS= read -r pid; do
    [[ -r "/proc/$pid/cmdline" ]] || continue
    argv=()
    mapfile -d '' -t argv < "/proc/$pid/cmdline" 2>/dev/null || continue
    [[ "${argv[0]##*/}" == "qs" ]] || continue

    for ((i = 1; i + 1 < ${#argv[@]}; i++)); do
      if [[ "${argv[$i]}" == "-c" && "${argv[$((i + 1))]}" == "$QS_CONFIG" ]]; then
        printf '%s\n' "$pid"
        return 0
      fi
    done
  done < <(pgrep -u "$(id -u)" -x qs 2>/dev/null || true)

  return 1
}

print_shell_runtime_status() {
  local pid=""

  if systemctl --user --quiet is-active "$SERVICE"; then
    echo "  [ok] $SERVICE active"
    return 0
  fi

  if pid="$(foreground_shell_pid)"; then
    echo "  [ok] foreground Raohane runtime active (pid $pid; $SERVICE inactive)"
    return 0
  fi

  if systemctl --user --quiet is-failed "$SERVICE"; then
    echo "  [!!] $SERVICE failed and no foreground Raohane runtime was detected"
    return 1
  fi

  echo "  [--] no Raohane runtime active ($SERVICE inactive)"
  return 1
}

check_cmd() {
  local command_name="$1"
  local package_hint="${2:-}"
  local level="${3:-required}"

  if command -v "$command_name" >/dev/null 2>&1; then
    printf '  [ok] %-20s %s\n' "$command_name" "$(command -v "$command_name")"
    return 0
  fi

  if [[ "$level" == "optional" ]]; then
    printf '  [--] %-20s optional%s\n' "$command_name" "${package_hint:+ ($package_hint)}"
    return 0
  fi

  printf '  [!!] %-20s missing%s\n' "$command_name" "${package_hint:+ ($package_hint)}"
  return 1
}

find_dependency_installer() {
  local candidate
  for candidate in \
    "$RUNTIME/scripts/install-deps.sh" \
    "$SCRIPT_DIR/install-deps.sh" \
    "$SCRIPT_DIR/../scripts/install-deps.sh"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

find_runtime_payload_validator() {
  local candidate
  for candidate in \
    "$RUNTIME/scripts/validate-runtime-payload.sh" \
    "$SCRIPT_DIR/validate-runtime-payload.sh" \
    "$SCRIPT_DIR/../scripts/validate-runtime-payload.sh"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

find_phase4_validator() {
  local candidate
  for candidate in \
    "$RUNTIME/scripts/phase4-live-check.sh" \
    "$SCRIPT_DIR/phase4-live-check.sh" \
    "$SCRIPT_DIR/../scripts/phase4-live-check.sh"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

run_phase4_validator() {
  local validator=""
  if ! validator="$(find_phase4_validator)"; then
    echo '[Raohane] Phase 4 validator is missing. Reinstall from an up-to-date checkout.' >&2
    return 1
  fi
  bash "$validator" "$@"
}

find_release_validator() {
  local candidate
  for candidate in \
    "$RUNTIME/scripts/release-live-check.sh" \
    "$SCRIPT_DIR/release-live-check.sh" \
    "$SCRIPT_DIR/../scripts/release-live-check.sh"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

run_release_validator() {
  local validator=""
  if ! validator="$(find_release_validator)"; then
    echo '[Raohane] Release validator is missing. Reinstall from an up-to-date checkout.' >&2
    return 1
  fi
  bash "$validator" "$@"
}

print_command_report() {
  local failures=0

  echo 'Runtime commands'
  check_cmd qs quickshell || failures=$((failures + 1))
  check_cmd hyprctl hyprland || failures=$((failures + 1))
  check_cmd python3 python || failures=$((failures + 1))
  check_cmd nmcli networkmanager || failures=$((failures + 1))
  check_cmd wpctl wireplumber || check_cmd pactl libpulse || failures=$((failures + 1))
  check_cmd pw-mon pipewire || failures=$((failures + 1))

  echo
  echo 'Native feature backends'
  check_cmd bluetoothctl bluez-utils optional
  check_cmd blueman-manager blueman optional
  check_cmd nm-connection-editor network-manager-applet optional
  check_cmd brightnessctl brightnessctl optional
  check_cmd ddcutil ddcutil optional
  check_cmd hyprsunset hyprsunset optional
  check_cmd grim grim optional
  check_cmd slurp slurp optional
  check_cmd wf-recorder wf-recorder optional
  check_cmd wl-copy wl-clipboard optional
  check_cmd wl-paste wl-clipboard optional
  check_cmd cliphist cliphist optional
  check_cmd ffmpeg ffmpeg optional
  check_cmd magick imagemagick optional
  check_cmd notify-send libnotify optional
  check_cmd tesseract tesseract optional
  check_cmd trans translate-shell optional
  check_cmd ydotool ydotool optional
  check_cmd ydotoold ydotool optional
  check_cmd qalc libqalculate optional
  check_cmd easyeffects easyeffects optional
  check_cmd fprintd-list fprintd optional

  return "$failures"
}

print_dependency_report() {
  local failures=0
  local installer=""

  if installer="$(find_dependency_installer)" && command -v pacman >/dev/null 2>&1; then
    echo 'Raohane package manifest'
    bash "$installer" --full --check || failures=$((failures + 1))
    echo
  else
    echo 'Raohane package manifest'
    echo '  [--] package-level check unavailable; using command probes only'
    echo
  fi

  print_command_report || failures=$((failures + 1))

  echo
  if ((failures > 0)); then
    echo 'Dependency issues were detected.'
    return 1
  fi
  echo 'Raohane dependency manifest and native backend commands look available.'
}

print_runtime_integrity() {
  local failures=0
  local config_file="$CONFIG_HOME/raohane/native.json"
  local root_qml_count=0
  local family_qml_count=0
  local payload_validator=""

  echo 'Installed runtime integrity'
  printf '  path: %s\n' "$RUNTIME"

  for path in \
    "$RUNTIME/shell.qml" \
    "$RUNTIME/qmldir" \
    "$RUNTIME/modules/raohane" \
    "$RUNTIME/panelFamilies/RaohaneFamily.qml" \
    "$RUNTIME/scripts/prune-runtime.sh"; do
    if [[ -e "$path" ]]; then
      printf '  [ok] %s\n' "${path#$RUNTIME/}"
    else
      printf '  [!!] missing %s\n' "${path#$RUNTIME/}"
      failures=$((failures + 1))
    fi
  done

  for path in \
    "$RUNTIME/modules/common" \
    "$RUNTIME/modules/ii" \
    "$RUNTIME/services" \
    "$RUNTIME/GlobalStates.qml" \
    "$RUNTIME/ReloadPopup.qml" \
    "$RUNTIME/panelFamilies/IllogicalImpulseFamily.qml"; do
    if [[ -e "$path" ]]; then
      printf '  [!!] retired path present: %s\n' "${path#$RUNTIME/}"
      failures=$((failures + 1))
    fi
  done

  if [[ -d "$RUNTIME" ]]; then
    root_qml_count="$(find "$RUNTIME" -mindepth 1 -maxdepth 1 -type f -name '*.qml' -printf '.' 2>/dev/null | wc -c)"
    if [[ "$root_qml_count" -eq 1 && -f "$RUNTIME/shell.qml" ]]; then
      echo '  [ok] shell.qml is the only root QML component'
    else
      printf '  [!!] root QML count=%s (expected only shell.qml)\n' "$root_qml_count"
      failures=$((failures + 1))
    fi
  fi

  if [[ -d "$RUNTIME/panelFamilies" ]]; then
    family_qml_count="$(find "$RUNTIME/panelFamilies" -mindepth 1 -maxdepth 1 -type f -name '*.qml' -printf '.' 2>/dev/null | wc -c)"
    if [[ "$family_qml_count" -eq 1 && -f "$RUNTIME/panelFamilies/RaohaneFamily.qml" ]]; then
      echo '  [ok] RaohaneFamily is the only installed panel family'
    else
      printf '  [!!] panel family QML count=%s (expected only RaohaneFamily)\n' "$family_qml_count"
      failures=$((failures + 1))
    fi
  fi

  if [[ -f "$config_file" ]]; then
    if python3 - "$config_file" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)
raise SystemExit(0 if data.get("schemaVersion") == 12 else 1)
PY
    then
      echo '  [ok] ~/.config/raohane/native.json schema v12'
    else
      echo '  [!!] ~/.config/raohane/native.json is missing/invalid schema v12'
      failures=$((failures + 1))
    fi
  else
    echo '  [!!] ~/.config/raohane/native.json is missing'
    failures=$((failures + 1))
  fi

  echo
  echo 'Strict runtime payload'
  if payload_validator="$(find_runtime_payload_validator)"; then
    if bash "$payload_validator" "$RUNTIME"; then
      echo '  [ok] runtime payload validator passed'
    else
      echo '  [!!] runtime payload validator failed'
      failures=$((failures + 1))
    fi
  else
    echo '  [!!] validate-runtime-payload.sh is missing'
    failures=$((failures + 1))
  fi

  if ((failures == 0)); then
    echo '  [ok] installed runtime is standalone Raohane'
  fi
  return "$failures"
}

print_audio_status() {
  if command -v wpctl >/dev/null 2>&1; then
    echo 'Default output'
    printf '  '
    wpctl get-volume @DEFAULT_SINK@ 2>/dev/null || echo 'unavailable'
    wpctl inspect @DEFAULT_SINK@ 2>/dev/null \
      | sed -n 's/^[[:space:]]*\*\? node.description = "\(.*\)"/  device: \1/p' \
      | head -1 || true

    echo
    echo 'Default input'
    printf '  '
    wpctl get-volume @DEFAULT_SOURCE@ 2>/dev/null || echo 'unavailable'
    wpctl inspect @DEFAULT_SOURCE@ 2>/dev/null \
      | sed -n 's/^[[:space:]]*\*\? node.description = "\(.*\)"/  device: \1/p' \
      | head -1 || true

    echo
    echo 'Audio graph'
    wpctl status -n 2>/dev/null | sed -n '/^Audio$/,/^Video$/p' || true
  elif command -v pactl >/dev/null 2>&1; then
    pactl info | grep -E 'Default Sink|Default Source' || true
  else
    echo 'Neither wpctl nor pactl is available.' >&2
    return 1
  fi
}

recover_audio() {
  local percent="${1:-50}"

  if ! command -v wpctl >/dev/null 2>&1; then
    echo 'wpctl is required for audio recovery (package: wireplumber).' >&2
    return 1
  fi

  if [[ ! "$percent" =~ ^[0-9]+$ ]] || ((percent < 1 || percent > 100)); then
    echo 'Audio recovery percent must be an integer from 1 to 100.' >&2
    return 2
  fi

  if ! wpctl inspect @DEFAULT_SINK@ >/dev/null 2>&1; then
    echo 'No default audio sink is available.' >&2
    return 1
  fi

  echo "[Raohane] Restoring default sink to ${percent}% and unmuting it..."
  wpctl set-volume @DEFAULT_SINK@ "${percent}%"
  wpctl set-mute @DEFAULT_SINK@ 0

  local easyeffects_id=""
  easyeffects_id="$(wpctl status -n 2>/dev/null | sed -n 's/^[^0-9]*\([0-9][0-9]*\)\. easyeffects_sink.*/\1/p' | head -1 || true)"
  if [[ -n "$easyeffects_id" ]]; then
    wpctl set-volume "$easyeffects_id" 1.0 >/dev/null 2>&1 || true
    wpctl set-mute "$easyeffects_id" 0 >/dev/null 2>&1 || true
  fi

  echo '[Raohane] Audio state after recovery:'
  wpctl get-volume @DEFAULT_SINK@
}

case "${1:-help}" in
  run)
    prune_runtime_if_needed
    exec qs -c "$QS_CONFIG"
    ;;
  start)
    service_start
    ;;
  stop)
    systemctl --user stop "$SERVICE"
    systemctl --user reset-failed "$SERVICE" >/dev/null 2>&1 || true
    ;;
  restart)
    service_restart
    ;;
  status)
    systemctl --user --no-pager --full status "$SERVICE"
    ;;
  logs)
    exec journalctl --user -u "$SERVICE" -f
    ;;
  launcher)
    ipc raohaneLauncher toggle
    ;;
  control)
    ipc sidebarRight toggle
    ;;
  settings)
    ipc settings toggle
    ;;
  media)
    ipc raohaneMedia toggle
    ;;
  desktop)
    ipc raohaneDesktop toggle
    ;;
  session)
    ipc session toggle
    ;;
  translate)
    ipc screenTranslator translate
    ;;
  wallpaper)
    case "${2:-toggle}" in
      toggle) ipc wallpaperSelector toggle ;;
      random) ipc wallpaperSelector random ;;
      *) echo "Unknown wallpaper command: ${2:-}" >&2; exit 2 ;;
    esac
    ;;
  theme)
    theme_tool="$RUNTIME/scripts/theme-catalog.py"
    if [[ ! -f "$theme_tool" ]]; then
      theme_tool="$SCRIPT_DIR/theme-catalog.py"
    fi
    [[ -f "$theme_tool" ]] || {
      echo '[Raohane] Theme catalog tool is missing. Reinstall from an up-to-date checkout.' >&2
      exit 1
    }
    case "${2:-list}" in
      list)
        python3 "$theme_tool" list
        ;;
      import)
        [[ -n "${3:-}" ]] || { echo 'Usage: raohane theme import FILE' >&2; exit 2; }
        python3 "$theme_tool" import "$3"
        ;;
      import-serpantinum)
        [[ -n "${3:-}" ]] || { echo 'Usage: raohane theme import-serpantinum PATH' >&2; exit 2; }
        python3 "$theme_tool" import-serpantinum "$3"
        ;;
      remove)
        [[ -n "${3:-}" ]] || { echo 'Usage: raohane theme remove ID' >&2; exit 2; }
        python3 "$theme_tool" remove "$3"
        ;;
      export)
        [[ -n "${3:-}" && -n "${4:-}" ]] || { echo 'Usage: raohane theme export ID FILE' >&2; exit 2; }
        python3 "$theme_tool" export "$3" "$4"
        ;;
      *) echo "Unknown theme command: ${2:-}" >&2; exit 2 ;;
    esac
    ;;
  validate)
    case "${2:-}" in
      phase4)
        shift 2
        run_phase4_validator "$@"
        ;;
      release)
        shift 2
        run_release_validator "$@"
        ;;
      *)
        echo "Unknown validation target: ${2:-}" >&2
        exit 2
        ;;
    esac
    ;;
  doctor)
    case "${2:-all}" in
      graphics)
        echo 'Raohane doctor graphics'
        if command -v lspci >/dev/null 2>&1; then
          lspci -nnk | grep -EA3 'VGA|3D|Display' || true
        else
          echo 'lspci not found (package: pciutils)'
        fi
        echo
        command -v nvidia-smi >/dev/null 2>&1 \
          && nvidia-smi --query-gpu=name,driver_version --format=csv,noheader \
          || true
        command -v hyprctl >/dev/null 2>&1 && hyprctl monitors || true
        ;;
      deps)
        echo 'Raohane doctor dependencies'
        print_dependency_report
        ;;
      runtime)
        echo 'Raohane doctor runtime'
        print_runtime_integrity
        ;;
      phase4)
        run_phase4_validator
        ;;
      services)
        echo 'Raohane doctor services'
        if ! print_shell_runtime_status; then
          if systemctl --user --quiet is-failed "$SERVICE"; then
            journalctl --user -u "$SERVICE" -n 12 --no-pager || true
          fi
        fi

        for unit in pipewire.service wireplumber.service; do
          if systemctl --user --no-pager --quiet is-active "$unit" 2>/dev/null; then
            printf '  [ok] %s active\n' "$unit"
          else
            printf '  [--] %s not active/not found\n' "$unit"
          fi
        done

        if systemctl --no-pager --quiet is-active NetworkManager.service 2>/dev/null; then
          echo '  [ok] NetworkManager.service active'
        else
          echo '  [--] NetworkManager.service not active/not found'
        fi

        if systemctl --no-pager --quiet is-active bluetooth.service 2>/dev/null; then
          echo '  [ok] bluetooth.service active'
        else
          echo '  [--] bluetooth.service not active/not found'
        fi
        ;;
      all)
        echo 'Raohane doctor'
        echo
        print_dependency_report || true
        echo
        print_runtime_integrity || true
        echo
        echo 'Shell runtime'
        if ! print_shell_runtime_status; then
          if systemctl --user --quiet is-failed "$SERVICE"; then
            echo '  Recent service log:'
            journalctl --user -u "$SERVICE" -n 12 --no-pager | sed 's/^/    /' || true
          fi
        fi
        echo
        echo 'Runtime context'
        printf '  WAYLAND_DISPLAY=%s\n' "${WAYLAND_DISPLAY:-<unset>}"
        printf '  HYPRLAND_INSTANCE_SIGNATURE=%s\n' "${HYPRLAND_INSTANCE_SIGNATURE:-<unset>}"
        printf '  XDG_CURRENT_DESKTOP=%s\n' "${XDG_CURRENT_DESKTOP:-<unset>}"
        ;;
      *)
        echo "Unknown doctor target: ${2:-}" >&2
        exit 2
        ;;
    esac
    ;;
  wifi)
    case "${2:-status}" in
      status)
        if command -v nmcli >/dev/null 2>&1; then
          nmcli -t -f WIFI general 2>/dev/null || true
          nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi 2>/dev/null | grep '^yes:' || true
        else
          echo 'nmcli not found (package: networkmanager)' >&2
          exit 1
        fi
        ;;
      menu)
        ipc sidebarRight open
        ;;
      *) echo "Unknown wifi command: ${2:-}" >&2; exit 2 ;;
    esac
    ;;
  audio)
    case "${2:-status}" in
      status)
        print_audio_status
        ;;
      recover)
        recover_audio "${3:-50}"
        ;;
      *) echo "Unknown audio command: ${2:-}" >&2; exit 2 ;;
    esac
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    usage >&2
    exit 2
    ;;
esac
